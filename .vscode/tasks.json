{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build raylib",
            "type": "shell",
            "command": "gcc",
            "args": [
                "particle_simulation.c",
                "-o",
                "particle_simulation.exe",

                "-Wall",
                "-Wextra",

                "-std=c17",

                "-IC:/msys64/mingw64/include",
                "-LC:/msys64/mingw64/lib",

                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}